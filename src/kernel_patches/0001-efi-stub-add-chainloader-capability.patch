 drivers/firmware/efi/libstub/chainloader.c | 313 +++++++++++++++++++
 drivers/firmware/efi/libstub/chainloader.h |  26 ++
 drivers/firmware/efi/libstub/x86-stub.c   |  12 +
 4 files changed, 352 insertions(+)
 create mode 100644 drivers/firmware/efi/libstub/chainloader.c
 create mode 100644 drivers/firmware/efi/libstub/chainloader.h

